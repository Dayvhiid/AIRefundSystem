# Root .env for docker-compose variable substitution
# Copy this file to .env and fill in your API key for the chosen provider.
# Only the key for your chosen LLM_PROVIDER is required.

# Choose your LLM provider: groq | gemini | anthropic | openai | grok
LLM_PROVIDER=groq

# API keys — only the one for your chosen provider is required
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
