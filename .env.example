# Choose your LLM provider: gemini | anthropic | openai | grok | groq
LLM_PROVIDER=groq

# API keys — only the one for your chosen provider is required
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=

# Database (set automatically by docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/refundsystem

# Backend
PORT=4000

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
